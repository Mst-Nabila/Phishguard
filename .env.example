# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.

# Backend
PORT=3001
NODE_ENV=development

# Comma-separated list of allowed frontend origins (CORS)
CLIENT_ORIGIN=http://localhost:5173

# Timeout for calls to threat intelligence providers (milliseconds)
PROVIDER_TIMEOUT_MS=6000

# Threat intelligence providers (all optional, leave blank if unused)
GOOGLE_SAFE_BROWSING_API_KEY=
URLHAUS_AUTH_KEY=
VIRUSTOTAL_API_KEY=
# Frontend: backend address used in production builds.
# Leave empty in development because Vite proxies /api to the local server.
VITE_API_BASE_URL=
